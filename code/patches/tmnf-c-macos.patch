 static void futex_wake(_Atomic uint32_t *address, int count)
 {
+#ifdef __linux__
 	if (syscall(
 			SYS_futex, (uint32_t *)address,
 			FUTEX_WAKE_PRIVATE, count, NULL, NULL, 0) < 0) {
 		env_fail("futex wake failed");
 	}
+#else
+	(void)address;
+	(void)count;
+	pthread_mutex_lock(&g_tmnf_futex_mu);
+	pthread_cond_broadcast(&g_tmnf_futex_cv);
+	pthread_mutex_unlock(&g_tmnf_futex_mu);
+#endif
 }
 
